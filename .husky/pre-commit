#!/bin/bash

max_cpus=$(sysctl -n hw.ncpu)
max_cpus=$((max_cpus > 4 ? max_cpus : 4))
max_cpus=$((max_cpus - 1))

# Exit immediately if any command fails
set -e

# Run Jest tests (all unit tests)
echo "Running Jest tests..."
npm test -- --silent --verbose=false --reporters=summary --passWithNoTests

# Run type checking
echo ""
echo "Running type checking..."
npm run typecheck

# Run demo type checking
echo ""
echo "Running demo type checking..."
# Delete stale incremental cache before typechecking — tsc's --incremental false CLI flag
# does not reliably override tsconfig's `incremental: true` in TypeScript 5.x, so a stale
# .tsbuildinfo can cause TypeScript to skip re-checking recently modified files.
(cd demo/nextjs && rm -f tsconfig.tsbuildinfo && npm run typecheck)

# Run linting
echo ""
echo "Running linting..."
npm run lint

# Build package
echo ""
echo "Building package..."
npm run build

# Build GitHub Pages demo
echo ""
echo "Building GitHub Pages demo..."
(cd demo/nextjs && npm run build:pages)

# Auto-add dist folder to git index immediately after build
git add dist/ || true

# Refresh git index to ensure all changes are properly detected
git update-index --refresh || true

echo "Checking for unstaged changes in non-build files..."

# Check for unstaged changes OUTSIDE of build directories (these need manual review)
# git status --porcelain format: XY filename where Y is workspace status (space = clean, M = modified)
if git status --porcelain | grep '^.[M]' | grep -v -E "(dist/|demo/dist/)" | grep . > /dev/null; then
  echo "Changes detected in non-build files. Please review and commit the following files:" >&2
  git status --porcelain | grep '^.[M]' | grep -v -E "(dist/|demo/dist/)" >&2
  git update-index --again
  exit 1
fi

git update-index --again
